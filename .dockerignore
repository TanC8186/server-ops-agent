# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# 训练虚拟环境是 Windows 版 venv（pyvenv.cfg 里 home 指向宿主 Anaconda，只有
# Lib/Scripts、没有 bin/），在 Linux 容器里既跑不起来也用不上，但 `COPY . .`
# 会把它约 5.1GB 原样打进镜像；实测数字见 docs/claude-code-handoff/G5_INFRA_NOTES.md。
.venv-train/

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
.codebuddy/

# Sensitive
# `.env` 精确匹配覆盖不到 .env.docker / .env.production 等变体；构建上下文里
# 出现它们等于把凭据烤进镜像层。只放行模板。
.env*
!.env.example
*.pem
*.key

# Docker
Dockerfile
.dockerignore
docker-compose.yml
volumes/

# Logs & temp
logs/
uploads/
*.log
*.pid

# OS
.DS_Store
Thumbs.db

# Test
.pytest_cache/
.coverage
htmlcov/

# Frontend (built in the web stage)
web/node_modules/
web/dist/

# Training artifacts (models are too large for the image)
training/out/
training/data/*.jsonl
eval/results/

# 运行期数据与评测产物：`COPY . .` 会把本机的会话历史、ACL 侧表和题集产物
# 一起烤进镜像；/app/data 与 /app/eval 在 compose 里都是命名卷，烤进去也看不见。
data/
eval/rag/results/

# scratch 与构建变体：.g6* 之外还要覆盖 .g7* / tmp/ / .ui-check.png，
# 否则一次 `COPY . .` 就会把本机排障产物（含临时 key 文件）带进镜像。
.g6*
.g7*
.g6-local.Dockerfile
.g7-local.Dockerfile
tmp/
.tmp*/
.ui-check.png
