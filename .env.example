# 应用配置
APP_NAME=OnCallAgent
DEBUG=True
# 监听地址：默认只绑本机回环。要对外提供服务（或容器端口映射）必须显式改
# HOST=0.0.0.0 —— 这是 opt-in，不会默认把所有网卡暴露出去。
HOST=127.0.0.1
PORT=9900
# 仅信任的前端来源，逗号分隔；不要使用 *
CORS_ORIGINS=http://localhost:9900,http://127.0.0.1:9900

# 演示模式：1 = 无云凭证时返回带 source=demo 的合成数据；0 = 直接报 unavailable
DEMO_MODE=0

# ====== 访问控制 ======
# AUTH_MODE：
#   dev        —— 仓库默认。未设置 API_KEY 时不鉴权，只适合本机开发/演示；
#                 一旦设置了 API_KEY，所有 /api 路由仍然强制校验 X-API-Key。
#   deployment —— 未设置 API_KEY 时启动阶段直接失败（fail closed），
#                 绝不允许“以为开了鉴权其实没有”的实例对外服务。
# 注意：仓库默认是「未鉴权的本机开发」。若要暴露到本机以外的网络，
# 必须设置 AUTH_MODE=deployment 并配置一个真实的 API_KEY（不要用占位符）。
AUTH_MODE=dev
# API_KEY：留空 = dev 模式本地开发不鉴权；非空 = 所有 /api 路由要求 X-API-Key。
# 占位符（your-*/change-me 等）一律视为未配置。密钥只在服务端比较，不会被回显。
API_KEY=

# AI_CONFIG_FILE：仅供测试/部署指向另一份 env 文件（必须是进程环境变量，
# 写在 .env 里无效——否则配置文件会自己指定自己）。正常运行不要设置。
# AI_CONFIG_FILE=/path/to/other.env

# ====== Docker Compose 专用 ======
# CONTAINER_AUTH_MODE 是「宿主 shell 变量」，不是 .env 的配置项：不要把它写进
# .env。原因：compose 会用 .env 做变量插值，一旦 .env 里出现 dev，开发机的
# `docker compose up` 就会起一个无鉴权容器。容器默认 deployment（fail closed），
# 要跑未鉴权演示容器请在命令行显式覆盖：
#   CONTAINER_AUTH_MODE=dev docker compose up -d
# 容器始终通过 env_file 读取 .env 中的 API_KEY；compose 只透传变量名、不导出
# 空值，因此不会覆盖它。注意 Docker Compose 需 v2.24+（env_file 的
# required: false 长语法）。

# ====== LLM 配置 ======
# provider: anthropic（默认，Messages API）| openai（任意 OpenAI 兼容端点）
LLM_PROVIDER=anthropic
# anthropic 下这是 API 根地址，SDK 自动拼 /v1/messages
LLM_BASE_URL=https://www.autodl.art/api/v1/anthropic
LLM_API_KEY=your-api-key-here
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=4096

# 切换到 OpenAI 兼容端点（DeepSeek / DashScope / 本地 vLLM）时改成：
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# 本地小模型（vLLM / llama.cpp / Ollama 的 OpenAI 兼容接口）
# 双模式界面：本地模式只用此端点，不回退在线LLM；在线多智能体使用上面的LLM_*。
# 留空 = 本地模式未配置。历史无mode脚本仍保留“本地规划失败回退云端”的行为。
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=qwen-ops
LOCAL_LLM_MAX_TOKENS=768
DIAGNOSTIC_TIMEOUT_SECONDS=180
DIAGNOSTIC_TOOL_TIMEOUT_SECONDS=20
DIAGNOSTIC_MAX_TOOL_CALLS=10
# 与训练时的工具目录格式保持一致；训练用 --names-only 时保持 False
LOCAL_LLM_WITH_PARAMS=False

# HuggingFace 镜像（国内必设，否则模型加载会超时）
HF_ENDPOINT=https://hf-mirror.com

# Embedding 配置
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Milvus 配置
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_TIMEOUT=10000

# RAG 配置
RAG_TOP_K=3

# 文档分块配置
# 本地 embedding 模型上下文为 128 tokens，180 字符以内不会截断
CHUNK_MAX_SIZE=180
CHUNK_OVERLAP=40

# ====== 腾讯云 API 凭证 ======
TENCENTCLOUD_APPID=your-appid
TENCENTCLOUD_SECRET_ID=your-secret-id
TENCENTCLOUD_SECRET_KEY=your-secret-key
TENCENTCLOUD_REGION=ap-beijing

# MCP 服务配置
MCP_CLS_TRANSPORT=streamable-http
MCP_CLS_URL=http://localhost:8003/mcp
MCP_MONITOR_TRANSPORT=streamable-http
MCP_MONITOR_URL=http://localhost:8004/mcp
MCP_SSH_TRANSPORT=streamable-http
MCP_SSH_URL=http://localhost:8005/mcp

# SSH 远程服务器配置
SSH_HOST=your-server-ip
SSH_PORT=22
SSH_USER=Administrator
SSH_KEY_FILE=~/.ssh/your-key.pem
SSH_SERVER_TYPE=windows
